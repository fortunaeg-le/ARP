# РЕАЛЬНЫЕ документы (ПДн) — НИКОГДА не коммитить. Публичный репозиторий; в истории
# уже была утечка договора, чищено filter-repo. real_docs/ и любые дампы его текста
# держим ТОЛЬКО здесь. Не переносить дампы в experiments/ / docs/ / tests/.
real_docs/

# a0_gliner experiment: isolated venv + model cache not tracked
experiments/a0_gliner/venv_gliner/
experiments/a0_gliner/hf_cache/

# Реальный договор владельца (и его варианты) — НИКОГДА не коммитить.
# Эта запись была сломана: файл дописали в UTF-16LE, из-за чего git видел имя
# из NUL-байтов и не совпадал НИ С ЧЕМ. Восстановлена в UTF-8 (этап S2).
# ВАЖНО: не добавлять сюда *.docx — под него попали бы нужные фикстуры
# tests/fixtures/*.docx и замороженный корпус tests/corpus/docs/*.docx.
/dogovor.docx
/dogovor.*

# ЭТАП U4: отчёты о качестве, которые пользователь скачивает из интерфейса.
# Текста документов в них нет ПО ПОСТРОЕНИЮ (app/report.py, белый список полей
# + структурный часовой), но это данные пилота, а не код, и публичному
# репозиторию они не нужны. Сами разметка и сессии лежат вне репозитория —
# в ~/.shifrator/ (см. .shifrator/ выше), сюда не попадают в принципе.
shifrator_report_*.json
shifrator_report_*.md

# Отладочный дамп гейта: перезаписывается КАЖДЫМ прогоном (7 МБ) — держать
# в истории незачем, точка отсчёта живёт в results_baseline.json (этап S2).
tests/corpus/results_gate_current.json
